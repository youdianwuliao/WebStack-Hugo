/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://static.cloudflareinsights.com https://sdk.51.la; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' blob: https://counter.justgame.top https://collect-v6.51.la; font-src 'self' data:; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Service Worker 不缓存，保证版本更新即时生效
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# HTML 页面：短缓存 + 协商验证，SW 负责离线兜底
/
/index.html
/*/index.html
  Cache-Control: public, max-age=0, must-revalidate

# 导航数据是 JSON 数据而非文档，单独一档：短缓存 + SWR。
# SW 侧本就是 stale-while-revalidate（重复访问缓存直出），这里再给一层 HTTP 缓存，
# 省掉无 SW / 首次访问时的条件请求；导航更新靠推代码时的 SW CACHE 版本号即时生效。
/nav.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# 站内图标与静态脚本：长缓存（文件名或内容变更通过 SW 版本刷新）
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# 共享阅读样式与脚本（gushi/maoxuan/shiji/jiashen/nanmingshi 400+ 正文页复用）：
# 浏览器缓存 1 小时 + CDN SWR 一天，缩短冷缓存与无 SW 场景的重复回源；
# SW 接管后由 CACHE 版本号（v68）保证全局样式更新
/gushi/gushi.css
/gushi/gushi.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# 心史原书书影（247 叶扫描 + 缩略图，约 60MB）：内容是历史影像，不会变，
# 给长缓存。否则宿主默认 max-age=14400 + must-revalidate，超过 4 小时重访
# 书影页会打出 247 个条件请求。日后若替换图片，需改名或接受最长 7 天陈旧。
/xinshi/scans/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# 工具页静态库：长缓存，内容变更靠 SW CACHE 版本刷新
/qrcode/jsqr.js
/jianfen/data.js
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# FFmpeg.wasm 分片（约 31MB）：URL 已带 ?v= 版本参数，不可变长缓存避免重复回源
/image/ffmpeg/*
  Cache-Control: public, max-age=31536000, immutable
